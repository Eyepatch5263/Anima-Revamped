# Copy this file to .env for local development. This template contains no credentials.
# Keep the included assets/ folder beside package.json when extracting the local bundle.
ANIMA_LOCAL_ASSETS_DIR=./assets

# Optional: set both values only if you operate an Umami-compatible analytics endpoint locally.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=

# Optional: needed only to test Manus OAuth login and database-backed account workflows.
# DATABASE_URL=
# JWT_SECRET=
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
